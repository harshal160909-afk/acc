# ACC server configuration. Put real secrets in the hosting secret manager,
# never in this file, browser code, Git, screenshots, or chat messages.

# Google OAuth 2.0 / OpenID Connect. APP_BASE_URL must be the exact HTTPS origin
# users visit, without a path or trailing slash. Register this exact callback:
#   ${APP_BASE_URL}/auth/google/callback
APP_BASE_URL=https://your-acc-domain.example
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Primary AI provider: openai or nvidia
AI_DEFAULT_PROVIDER=openai
AI_FALLBACK_PROVIDER=nvidia
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_TOOL_STEPS=4

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional NVIDIA OpenAI-compatible fallback
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=

# Optional licensed market-data/news adapter.
# ACC stays in an explicit configuration-required state without all three.
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=
MARKET_DATA_DEFAULT_DELAY_MINUTES=15
AI_ENABLE_MARKET_NEWS=false

# ACC Market Intelligence public-source adapters. A connector stays unavailable
# until both its official credentials and the compliance approval flag are set.
# Reddit API access may require Reddit's written approval for the intended use.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
REDDIT_COMMERCIAL_APPROVAL=false

# YouTube Data API v3. Enable only after reviewing the YouTube API Services
# Terms, developer policies, privacy disclosure, and retention obligations.
YOUTUBE_DATA_API_KEY=
YOUTUBE_COMPLIANCE_APPROVED=false

# Public support links. These are intentionally safe to expose.
NEXT_PUBLIC_SUPPORT_PHONE_E164=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_HANDLE=
